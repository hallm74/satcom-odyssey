---
import { projects } from '../../config/projects';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
---

<div class="project-grid">
	{projects.map((project) => (
		<article class:list={['project-card', { 'project-featured': project.featured }]}>
			<div class="project-preview" style={`--project-accent: ${project.accent}`}>
				<img src={project.image} alt={`${project.name} website preview`} width="1200" height={project.featured ? 1018 : 675} loading="lazy" />
			</div>
			<div class="project-content">
				<p class="project-category">{project.category}</p>
				<h3>{project.name}</h3>
				<p class="project-description">{project.description}</p>
				{detailed && <ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>}
				<a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} (opens in a new tab)`}>
					{project.linkLabel || 'Visit project'} <span aria-hidden="true">↗</span>
				</a>
			</div>
			{detailed && project.details && (
				<div class="project-details" aria-label={`${project.name} details`}>
					{project.details.map((detail) => (
						<div><h4>{detail.title}</h4><p>{detail.text}</p></div>
					))}
				</div>
			)}
		</article>
	))}
</div>

<style>
	.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
	.project-card { display: flex; flex-direction: column; border: 1px solid #dfe3df; border-radius: 1.25rem; overflow: hidden; background: var(--theme-bg); }
	.project-preview { padding: 1.4rem 1.4rem 0; background: var(--project-accent); overflow: hidden; }
	.project-preview img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; object-position: top; border-radius: .5rem .5rem 0 0; box-shadow: 0 4px 24px #00000012; }
	.project-content { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
	.project-category { color: #47624e; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
	h3 { font-size: clamp(1.2rem, 1.7vw, 1.55rem); line-height: 1.25; }
	.project-description, ul { font-size: .88rem; color: #424b45; }
	ul { padding-left: 1.1rem; margin: 0 0 1.5rem; }
	li + li { margin-top: .35rem; }
	a { margin-top: auto; padding-top: .5rem; display: flex; justify-content: space-between; align-items: center; color: var(--theme-on-bg); font-size: .85rem; font-weight: 700; text-underline-offset: .25em; }
	a:hover { color: #355f41; }
	a:focus-visible { outline: 2px solid #355f41; outline-offset: 5px; border-radius: 2px; }
	.project-featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1.15fr 1fr; }
	.project-featured .project-preview { padding: 1.5rem; display: flex; align-items: center; }
	.project-featured .project-preview img { aspect-ratio: 1200 / 1018; border-radius: .5rem; }
	.project-featured .project-content { justify-content: center; padding: clamp(1.5rem, 3vw, 3rem); }
	.project-featured h3 { font-size: clamp(1.8rem, 3vw, 2.7rem); letter-spacing: -.035em; }
	.project-featured .project-description { font-size: 1rem; }
	.project-featured a { margin-top: 1rem; }
	.project-details { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding: 2rem; border-top: 1px solid #dfe3df; background: #f7f8f4; }
	.project-details h4 { font-size: 1.1rem; margin: 0 0 .7rem; }
	.project-details p { color: #424b45; font-size: .88rem; line-height: 1.65; margin: 0; }
	@media (max-width: 850px) { .project-featured, .project-details { grid-template-columns: 1fr; } .project-details { gap: 1.5rem; padding: 1.5rem; } }
	@media (max-width: 850px) { .project-grid { grid-template-columns: 1fr; } .project-preview { padding: 1.25rem 1.25rem 0; } }
</style>
