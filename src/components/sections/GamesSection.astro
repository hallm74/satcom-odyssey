---
import { Button } from '@components/odyssey-theme';
---

<section id="games" class="games-section" aria-labelledby="games-title">
	<div class="games-heading">
		<h2 id="games-title">Games</h2>
		<p>A little time to explore and play.</p>
	</div>
	<article class="game-card">
		<div class="game-preview">
			<img
				src="/assets/images/projects/little-walks-many.webp?v=20260907"
				alt="Little Walks: Many title screen, with the updated character and Start a little adventure button"
				width="1200"
				height="675"
				loading="lazy"
			/>
		</div>
		<div class="game-content">
			<p class="game-category">Browser game · Many, Louisiana</p>
			<h3>Little Walks: Many</h3>
			<p>Take a stroll through a playful 3D version of Many, Louisiana. Explore familiar places, find local landmarks, and enjoy a little hometown adventure right in your browser.</p>
			<Button href="https://little-walks-many.netlify.app">Play Little Walks: Many</Button>
		</div>
	</article>
</section>

<style>
	.games-section { margin: 4rem 0; scroll-margin-top: 2rem; }
	.games-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
	.games-heading h2 { font-size: 1.8rem; }
	.games-heading p { font-size: .85rem; color: #566259; }
	.game-card { display: grid; grid-template-columns: 1.2fr 1fr; border: 1px solid #dfe3df; border-radius: 1.25rem; overflow: hidden; }
	.game-preview { display: flex; align-items: center; background: #e9eddf; padding: 1.5rem; }
	.game-preview img { width: 100%; height: auto; border-radius: .75rem; box-shadow: 0 4px 24px #00000012; }
	.game-content { align-self: center; padding: 2rem; }
	.game-category { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #47624e; }
	h3 { font-size: clamp(1.35rem, 2vw, 1.8rem); line-height: 1.25; }
	.game-content > p:not(.game-category) { color: #424b45; font-size: .95rem; margin-bottom: 1.5rem; }
	@media (max-width: 850px) { .games-heading { display: block; } .game-card { grid-template-columns: 1fr; } .game-content { padding: 1.5rem; } .game-preview { padding: 1.25rem; } }
</style>
