---
const projects = [
	{ name: 'Meeting Notes', benefit: 'From recordings to next steps.', image: '/assets/images/projects/meeting-notes.png', href: 'https://satcom-meetingminutes.netlify.app' },
	{ name: 'All Things Sabine Menus', benefit: 'Find your next local favorite.', image: '/assets/images/projects/menus.webp', href: 'https://menus.allthingssabine.com' },
];
---

<aside class="built-showcase" aria-labelledby="built-title">
	<header>
		<p class="eyebrow">Web / App / AI</p>
		<h2 id="built-title">Built by SatCom<span>.</span></h2>
	</header>
	<a class="radio-project" href="https://bdcradio.com" target="_blank" rel="noopener noreferrer" aria-label="Explore BDC Radio (opens in a new tab)">
		<div class="radio-image"><img src="/assets/images/projects/bdc-redesign.webp" alt="BDC Radio website with its vinyl record station guide" width="1200" height="1018" /></div>
		<div class="radio-caption"><div><span class="project-name">BDC Radio</span><h3>Local radio, wherever you are.</h3></div><span class="arrow" aria-hidden="true">↗</span></div>
	</a>
	<div class="small-projects">
		{projects.map(project => (
			<a class="small-project" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${project.name} (opens in a new tab)`}>
				<img src={project.image} alt="" width="1200" height="675" loading="lazy" />
				<div><h3>{project.name}<span aria-hidden="true">↗</span></h3><p>{project.benefit}</p></div>
			</a>
		))}
	</div>
	<a class="all-projects" href="/projects">See what else we’re building <span aria-hidden="true">→</span></a>
</aside>

<style>
	.built-showcase { width: 100%; min-width: 0; aspect-ratio: 3 / 2; display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; gap: .6rem; padding: 1rem; border-radius: 1.5rem; background: #edf1e9; color: #15291d; border: 1px solid #dde5d8; }
	header { margin: 0; }
	.eyebrow { margin: 0 0 .25rem; font-size: .55rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: #526348; }
	h2 { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.15; letter-spacing: -.04em; }
	h2 span { color: #6c8451; }
	a { color: inherit; text-decoration: none; }
	.radio-project, .small-project { display: block; overflow: hidden; background: #fff; border: 1px solid #dce2d6; border-radius: .8rem; transition: box-shadow .2s; }
	.radio-project:hover, .small-project:hover { box-shadow: 0 5px 16px #20361916; }
	.radio-project { min-height: 0; display: grid; grid-template-columns: 1.1fr 1fr; grid-template-rows: minmax(0, 1fr); }
	.radio-image { min-height: 0; overflow: hidden; background: #f5f4ef; }
	.radio-image img { width: 100%; height: 100%; object-fit: contain; display: block; }
	.radio-caption { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .45rem .7rem; }
	.radio-caption h3 { font-size: 1rem; }
	.project-name { display: block; font-size: .58rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #62725b; margin-bottom: .25rem; }
	h3 { margin: 0; font-family: var(--theme-font-family-sans, sans-serif); font-size: .85rem; line-height: 1.35; letter-spacing: -.015em; }
	.arrow { font-size: 1.2rem; }
	.small-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
	.small-project { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); align-items: center; }
	.small-project img { display: block; width: 100%; height: 100%; min-height: 3.4rem; object-fit: cover; object-position: center; background: #f4f4ed; }
	.small-project > div { min-width: 0; padding: .4rem .5rem; }
	.small-project h3 { display: flex; justify-content: space-between; gap: .3rem; font-size: .7rem; }
	.small-project p { margin: .3rem 0 0; font-size: .62rem; line-height: 1.45; color: #60705c; }
	.all-projects { display: flex; align-items: center; justify-content: space-between; font-size: .7rem; font-weight: 700; }
	.all-projects:hover { text-decoration: underline; text-underline-offset: .2em; }
	a:focus-visible { outline: 3px solid #537841; outline-offset: 4px; }
	@media (max-width: 1100px) { .built-showcase { aspect-ratio: auto; } .radio-image { height: 150px; } }
	@media (max-width: 480px) { .small-projects { grid-template-columns: 1fr; } }
	@media (prefers-reduced-motion: reduce) { .radio-project, .small-project { transition: none; } }
</style>
